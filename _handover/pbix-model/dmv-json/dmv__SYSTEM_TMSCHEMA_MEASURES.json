    {
        "ID":  93069,
        "TableID":  13,
        "Name":  "صافي البريم النهائي",
        "Description":  null,
        "DataType":  8,
        "Expression":  "\nVAR CurrentInternalNo = SELECTEDVALUE(\u0027تسجيل_العقود\u0027[الرقم داخلي])\nVAR CurrentCategory   = SELECTEDVALUE(\u0027تسجيل_العقود\u0027[التصنيف])\nVAR OriginalPremium   = SELECTEDVALUE(\u0027تسجيل_العقود\u0027[بريم التعاقد])\n\n-- 1. جلب بريم الربط الأساسي بشكل معزول (إن وُجد)\nVAR RabtPremium = \n    CALCULATE(\n        AVERAGE(\u0027تسجيل_العقود\u0027[بريم التعاقد]), \n        FILTER(\n            ALL(\u0027تسجيل_العقود\u0027), \n            \u0027تسجيل_العقود\u0027[الرقم داخلي] = CurrentInternalNo \u0026\u0026 \u0027تسجيل_العقود\u0027[التصنيف] = CurrentCategory\n        )\n    )\n\n-- 2. تحديد السعر الأساسي (الربط أولاً، وإلا التعاقد)\nVAR BasePremium = IF(ISBLANK(RabtPremium), OriginalPremium, RabtPremium)\n\n-- 3. حساب المتوسط المرجح التراكمي لكل بورصة رولينج مستقلة وعزلها تماماً\nVAR RollingCumulativeImpact = \n    SUMX(\n        CALCULATETABLE(\n            DISTINCT(\u0027الرولينج\u0027[بورصة الرولينج]),\n            FILTER(\n                ALL(\u0027الرولينج\u0027),\n                \u0027الرولينج\u0027[الرقم الداخلي] = CurrentInternalNo \u0026\u0026 \u0027الرولينج\u0027[الصنف] = CurrentCategory\n            )\n        ),\n        VAR CurrentBourse = \u0027الرولينج\u0027[بورصة الرولينج]\n        RETURN\n        CALCULATE(\n            DIVIDE(\n                SUMX(\u0027الرولينج\u0027, \u0027الرولينج\u0027[كمية الترويل] * \u0027الرولينج\u0027[سعر الرولينج]),\n                SUM(\u0027الرولينج\u0027[كمية الترويل]),\n                0\n            ),\n            FILTER(\n                ALL(\u0027الرولينج\u0027),\n                \u0027الرولينج\u0027[الرقم الداخلي] = CurrentInternalNo \u0026\u0026 \n                \u0027الرولينج\u0027[الصنف] = CurrentCategory \u0026\u0026 \n                \u0027الرولينج\u0027[بورصة الرولينج] = CurrentBourse\n            )\n        )\n    )\n\nRETURN\nBasePremium + COALESCE(RollingCumulativeImpact, 0)\n",
        "FormatString":  null,
        "IsHidden":  false,
        "State":  1,
        "ModifiedTime":  "\/Date(1791103334110)\/",
